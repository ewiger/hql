# ADR status

Every proposal under [`doc/proposals/`](../proposals/index.hmd), read from its
folder note: the number, the title, the status, and how far it is implemented: `yes` for `implemented` and
`superseded`, `partially` for `implemented in part`, `no` for `drafted`,
`accepted`, `rejected` and `outdated`. A status outside
[[proposals#status|the list]] shows as `invalid`.

```hql#eval
import regex

// The text after `**Status**:` on the folder note's status line.
fn status_of(body: String) : String =
    regex.find(body, "\\*\\*Status\\*\\*:[^\\n]*")
    | map(s => regex.replace_first(s, "^\\*\\*Status\\*\\*: *", ""))
    | unwrap_or("unknown")

// How far a status says the proposal is implemented, or `invalid` for a
// value outside the list in the proposals index.
fn implemented_of(status: String) : String =
    "partially" given status == "implemented in part"
    otherwise ("yes" given status == "implemented"
    otherwise ("yes" given status == "superseded"
    otherwise ("no" given status == "drafted"
    otherwise ("no" given status == "accepted"
    otherwise ("no" given status == "rejected"
    otherwise ("no" given status == "outdated"
    otherwise "invalid"))))))

// A wikilink to the proposal, which its folder note answers to.
fn adr_link(id: String) : String =
    "[[" + id + "]]"

cards
| filter(c => c.path.contains("proposals/HQL-") and c.path.ends_with("/index.hmd"))
| sort(by = c => c.path)
| map(c => {
    adr: adr_link(regex.find(c.path, "HQL-[0-9]+").unwrap_or(c.name)),
    title: regex.replace_first(c.title, "^HQL-[0-9]+: *", ""),
    status: status_of(c.body),
    implemented: implemented_of(status_of(c.body))
  })
| Table(columns = ["adr", "title", "status", "implemented"])
| format(as = Markdown)
```
