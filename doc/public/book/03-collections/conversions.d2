# Moving between collection types: every conversion is written.
# Rendered to conversions.svg with `d2 --layout elk conversions.d2 conversions.svg`.

direction: right

list: "List<T>" {style.fill: "#eef6ee"}
set: "Set<T>" {style.fill: "#eef6ee"}
map: "Map<K, V>" {style.fill: "#eef6ee"}
pairs: "List<Pair<K, V>>" {style.fill: "#eef6ee"}
lists: "List<K>, List<V>" {style.fill: "#eef6ee"}

list -> set: "Set(xs), xs | Set\nrepeats removed"
set -> list: "sort\nan order is chosen"
lists -> map: "Map(keys, values)"
lists -> pairs: "zip"
map -> pairs: "entries"
map -> set: ".keys"
map -> list: "values"
